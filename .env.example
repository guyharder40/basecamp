# Copy to .env for local dev. Never commit a real .env with secrets.
# Local dev (SQLite file, no setup needed):
#   (leave DATABASE_URL empty — the app runs in single-user local mode
#    with the seeded profile, no sign-in required)
# Hosted (Supabase free Postgres — required for shared data on Vercel):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=
# Optional: override the local SQLite file location
# SQLITE_PATH=./data/basecamp.db
# Server port for local dev
PORT=3001

# --- Supabase Auth (free tier) — optional locally, required for sign-in ---
# Get these from your Supabase project: Project Settings → API.
# SUPABASE_URL is the Project URL; SUPABASE_ANON_KEY is the anon/public key
# (safe to expose in the browser); SUPABASE_SERVICE_ROLE_KEY is the
# service_role key (SERVER ONLY — never ship it to the client). Without all
# three, the app runs in local dev mode.
# The client build needs NO VITE_SUPABASE_* vars: on startup the browser
# fetches GET /api/auth/config and the server hands it the public values
# from these server vars, so a plain `npm run build` always ships sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Google sign-in: enable Google in Supabase Dashboard →
# Authentication → Providers, then set this to 1 to show the button.
SUPABASE_GOOGLE_ENABLED=0

# --- Founder badge window ---
# The Founder badge is for people who join in the app's first year.
# Default: through Nov 14, 2027 (one year from the Nov 13, 2026 debut).
# IMPORTANT: when the app actually publishes, set this to one year from
# the real publish date.
FOUNDER_CUTOFF=2027-11-14
